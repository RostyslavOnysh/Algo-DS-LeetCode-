class Solution {
   public int maxDistance(int [] colors) {
     int res = 0;
     int n = colors.length;

     for (int i = n - 1; i >= 0; i--) {
        if (colors[i] != colors[0]) {
        res = Math.max(i, res);
         }
       }

     for (int i = 0; i < n; i++) {
        if (colors[i] != colors[0]) {
        res = Math.max(res, n - 1 - i);
        break;
         }
       }
    return res;
 }
}